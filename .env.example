# INFYNEX Complete Simulation Environment Configuration
# Pinned Base Versions
UBUNTU_HOST_VERSION=26.04
DOCKER_BASE_IMAGE=ubuntu:24.04
ROS_DISTRO=jazzy
GZ_VERSION=harmonic
PX4_VERSION=v1.15.4
MICRO_XRCE_VERSION=v2.4.3
PX4_MSGS_VERSION=release/1.15

# Host & Container Setup
HOST_IP=127.0.0.1
ROS_DOMAIN_ID=0
SIMULATION_MODE=sitl

# PX4 SITL & Gazebo Settings
PX4_MODEL=gz_x500
PX4_SIM_SPEED_FACTOR=1.0
PX4_HEADLESS=1
GAZEBO_WORLD=bridge_inspection.sdf

# Camera Settings
CAMERA_RESOLUTION_WIDTH=1280
CAMERA_RESOLUTION_HEIGHT=720
CAMERA_FPS=30
CAMERA_HORIZONTAL_FOV=80

# 5G Network Simulation Settings (ns-3 / 5G-LENA + tc netem)
5G_GNB_COUNT=1
5G_CARRIER_FREQ_GHZ=3.5
5G_BANDWIDTH_MHZ=100
NETEM_INTERFACE=infynex_5g_ran
NETEM_DEFAULT_LATENCY_MS=15
NETEM_DEFAULT_JITTER_MS=2
NETEM_DEFAULT_LOSS_PERCENT=0.1
NETEM_DEFAULT_RATE_MBPS=100

# MQTT Settings (IoT Sensor Network)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=60

# Backend & Database
DATABASE_URL=postgresql+asyncpg://infynex:infynex_pass@timescaledb:5432/infynex_db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=infynex-simulation-secret-key-development

# Dashboard Settings
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
