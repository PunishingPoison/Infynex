# ==============================================================================
# INFYNEX Hardware Override Configuration
# Copy this file to .env.hardware when migrating from simulation to physical hardware
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DRONE AUTOPILOT CONNECTION (Holybro Pixhawk 6C / CUAV v6X)
# ------------------------------------------------------------------------------
# In SITL: udp://:14540
# In Hardware: Serial UART or Ethernet MAVLink / MicroXRCE-DDS
PX4_SIMULATION_MODE=hardware
DRONE_SERIAL_DEVICE=/dev/ttyAMA0
DRONE_SERIAL_BAUDRATE=921600
UXRCE_DDS_AGENT_IP=10.45.0.2
UXRCE_DDS_AGENT_PORT=8888

# ------------------------------------------------------------------------------
# 2. CAMERA PAYLOAD (Raspberry Pi 5 + Sony IMX708 / FLIR Blackfly)
# ------------------------------------------------------------------------------
# In SITL: /infynex/camera/image_raw ROS 2 topic
# In Hardware: Live H.264 RTSP stream from Raspberry Pi
CAMERA_FEED_TYPE=rtsp
CAMERA_RTSP_URL=rtsp://10.45.0.2:8554/live
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# ------------------------------------------------------------------------------
# 3. IOT SENSOR FLEET (Physical ESP32-S3 Nodes over 5G / WiFi)
# ------------------------------------------------------------------------------
# In SITL: iot-emulators container
# In Hardware: Physical ESP32 nodes publishing to broker
IOT_SIMULATION_ENABLED=false
MQTT_BROKER_HOST=10.45.0.1
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=15

# ------------------------------------------------------------------------------
# 4. 5G CELLULAR MODEM (Quectel RM500Q / RM520N)
# ------------------------------------------------------------------------------
# In SITL: net-5g-adapter with tc netem
# In Hardware: Physical 5G network interface wwan0
NETEM_ENABLED=false
FIVE_G_MODEM_INTERFACE=wwan0
FIVE_G_APN=infynex.sa

# ------------------------------------------------------------------------------
# 5. EDGE AI INFERENCE (NVIDIA Jetson Orin Nano / RTX Edge)
# ------------------------------------------------------------------------------
AI_ENGINE_DEVICE=cuda:0
AI_WEIGHTS_PATH=/app/ai_engine/weights/best.pt
AI_CONFIDENCE_THRESHOLD=0.65
USE_TENSORRT=true

# ------------------------------------------------------------------------------
# 6. CENTRAL TIMESCALEDB & DASHBOARD
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://infynex:infynex_pass@10.45.0.1:5432/infynex_db
DASHBOARD_PORT=5173
BACKEND_API_PORT=8000
