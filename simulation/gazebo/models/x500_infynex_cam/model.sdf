<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_infynex_cam">
    <include merge="true">
      <uri>x500</uri>
    </include>
    <link name="camera_link">
      <pose relative_to="base_link">0.15 0.0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00005</iyy>
          <iyz>0</iyz>
          <izz>0.00005</izz>
        </inertia>
      </inertial>
      <visual name="camera_body">
        <geometry>
          <box><size>0.05 0.06 0.04</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      <visual name="camera_lens">
        <pose>0.03 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
      <sensor name="infynex_camera" type="camera">
        <pose>0.04 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov> <!-- 80 degrees -->
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
          <lens>
            <intrinsics>
              <fx>762.72</fx>
              <fy>762.72</fy>
              <cx>640.0</cx>
              <cy>360.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/infynex/camera/image_raw</topic>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
